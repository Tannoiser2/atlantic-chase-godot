; Atlantic Chase - versione digitale
; Progetto Godot 4.7

config_version=5

[application]

config/name="Atlantic Chase"
config/description="Versione digitale di Atlantic Chase (GMT Games). Uso personale."
run/main_scene="res://ui/splash/splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/counters/ship_ge_bb_bismarck.png"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1

